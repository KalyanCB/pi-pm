APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Comma-separated browser origins for local UI (preview :3000, Expo web :8081)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg://pipm:pipm@localhost:5432/pipm
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

YAHOO_REQUEST_TIMEOUT_SECONDS=30
MARKET_DATA_DEFAULT_PERIOD=1y

RANKING_DEFAULT_STRATEGY=momentum_v1
RANKING_DEFAULT_STRATEGY_VERSION=1.0.0
RANKING_DEFAULT_BENCHMARK=^NSEI
RANKING_DEFAULT_UNIVERSE_CODE=PI_PM_CORE
RANKING_MIN_HISTORY_DAYS=63
RANKING_MIN_AVG_DAILY_TRADED_VALUE=10000000
RANKING_MIN_STOCK_PRICE=50
RANKING_MARKET_DATA_SOURCE=yahoo
