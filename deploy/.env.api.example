# ============================================================
# Pi-PM PRODUCTION .env  — Hostinger KVM4 / paper auto-pilot
# ------------------------------------------------------------
# Copy to /opt/pi-pm/shared/.env, fill the CHANGE_ME values, chmod 600.
# deploy.sh symlinks this as ./.env at the release root. It is consumed
# BOTH as docker-compose variable substitution AND as the api env_file.
# NEVER commit the filled-in copy.
# ============================================================

APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# --- Deploy / compose substitution vars (docker-compose.prod.yml) ---
RELEASE_TAG=release-20260608-552c645
POSTGRES_PASSWORD=CHANGE_ME_strong_random_password
PUBLIC_HOST=187.127.177.217

# --- Database ---
# compose sets DATABASE_URL to the db service using POSTGRES_PASSWORD;
# this line is a fallback and should match POSTGRES_PASSWORD above.
DATABASE_URL=postgresql+psycopg://pipm:CHANGE_ME_strong_random_password@db:5432/pipm
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# --- Auth: DISABLED per ops decision (paper-only, no real money) ---
AUTH_ENABLED=false
# JWT is unused while auth is off; still set a non-default value.
JWT_SECRET_KEY=CHANGE_ME_random_32_bytes

# --- Trading mode: PAPER AUTO-PILOT ---
HITL_ENABLED=false
PAPER_TRADING_ENABLED=true
ENABLE_LIVE_TRADING=false
AUTO_EXIT_ON_CRITICAL_STOP=false
INTRADAY_EXIT_MONITOR_ENABLED=false
ADVISORY_STOP_PCT=-8.0
CRITICAL_STOP_PCT=-10.0

# --- Market data / ranking (match restored DB conventions) ---
YAHOO_REQUEST_TIMEOUT_SECONDS=30
MARKET_DATA_DEFAULT_PERIOD=1y
RANKING_DEFAULT_STRATEGY=momentum_v1
RANKING_DEFAULT_STRATEGY_VERSION=1.0.0
RANKING_DEFAULT_BENCHMARK=^NSEI
RANKING_DEFAULT_UNIVERSE_CODE=PI_PM_CORE
RANKING_MIN_HISTORY_DAYS=63
RANKING_MIN_AVG_DAILY_TRADED_VALUE=10000000
RANKING_MIN_STOCK_PRICE=50
RANKING_MARKET_DATA_SOURCE=yahoo

# --- CORS: single-origin via Caddy, kept for safety ---
CORS_ALLOWED_ORIGINS=http://187.127.177.217

# --- ARGS LLM (advisory only; mock keeps it deterministic/offline) ---
ARGS_LLM_PROVIDER=mock
