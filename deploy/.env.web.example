# Frontend (Expo web) build-time env. Copy to /opt/pi-pm/shared/.env.web
# (deploy.sh copies it to frontend/apps/web/.env before the build).
#
# IMPORTANT: EXPO_PUBLIC_* vars are INLINED AT BUILD TIME by `expo export`.
# Changing any of these requires rebuilding the frontend (re-run deploy.sh).

# Same-origin via Caddy reverse proxy: no host, no CORS.
EXPO_PUBLIC_API_BASE_URL=/api/v1

# Auth bypass ON per ops decision (API also has AUTH_ENABLED=false).
EXPO_PUBLIC_AUTH_BYPASS=true

EXPO_PUBLIC_DEFAULT_STRATEGY=momentum_v1
